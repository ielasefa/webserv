server {
    listen 127.0.0.1:8080;
    server_name webserv_main;
    client_max_body_size 10M;

    error_page 404 /errors/404.html;
    error_page 500 502 503 504 /errors/50x.html;

    location / {
        limit_except GET;
        root ./www/html;
        autoindex on;
        index index.html;
    }

    location /upload {
        limit_except GET POST DELETE;
        root ./www/uploads;
        allow_upload on;
        upload_path ./www/uploads;
    }

    location /cgi-bin {
        limit_except GET POST;
        root ./www/cgi-bin;
        cgi_pass .py /usr/bin/python3;
        cgi_pass .php /usr/bin/php-cgi;
        cgi_pass .sh /bin/bash; # Adding a third just to be safe
    }

    location /session {
        limit_except GET POST;
        root ./www/session-app;
        cgi_pass .php /usr/bin/php-cgi;
        index login.php;
    }

    location /old-page {
        return 301 http://127.0.0.1:8083/;
    }
}

server {
    listen 127.0.0.1:8080;
    server_name webserv_virtual;
    client_max_body_size 5M;

    location / {
        limit_except GET;
        root ./www/virtual_host;
        autoindex off;
        index default.html;
    }
}

server {
    listen 127.0.0.1:8083;
    server_name webserv_secondary;
    client_max_body_size 1M;

    location / {
        limit_except GET;
        root ./www/secondary;
        autoindex on;
    }
}